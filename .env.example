# Google Workspace SMTP (configure in Vercel or your production secret manager)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=sales@anrotex.com
SMTP_PASS=replace-with-a-google-app-password
LEAD_RECIPIENT=sales@anrotex.com

# Lead-form security
FORM_ALLOWED_ORIGINS=https://www.anrotex.com,https://anrotex.com
FORM_RATE_LIMIT_MAX=5
FORM_RATE_LIMIT_WINDOW_MS=600000
FORM_REQUIRE_TURNSTILE=false

# Cloudflare Turnstile
# Create a widget for anrotex.com, then configure both values at deployment.
# Change FORM_REQUIRE_TURNSTILE to true after both values are configured.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=www.anrotex.com,anrotex.com
