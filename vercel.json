{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        { "type": "host", "value": "anrotex.com" }
      ],
      "destination": "https://www.anrotex.com/:path*",
      "permanent": true
    },
    {
      "source": "/portfolio/cloud-operations/index.html",
      "destination": "/portfolio/cloud-operations",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/services", "destination": "/services/index.html" },
    { "source": "/privacy-policy", "destination": "/privacy-policy/index.html" },
    { "source": "/terms-of-use", "destination": "/terms-of-use/index.html" },
    { "source": "/downloads-policy", "destination": "/downloads-policy/index.html" },
    { "source": "/solutions", "destination": "/solutions/index.html" },
    { "source": "/case-studies", "destination": "/case-studies/index.html" },
    { "source": "/case-studies/fintech-aws-cost-reduction", "destination": "/case-studies/fintech-aws-cost-reduction/index.html" },
    { "source": "/contact", "destination": "/contact/index.html" },
    { "source": "/aws-cost-optimization", "destination": "/aws-cost-optimization/index.html" },
    { "source": "/kubernetes-scaling", "destination": "/kubernetes-scaling/index.html" },
    { "source": "/ci-cd-automation", "destination": "/ci-cd-automation/index.html" },
    { "source": "/devops-consulting", "destination": "/devops-consulting/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" },
    { "source": "/blog/reduce-aws-costs", "destination": "/blog/reduce-aws-costs/index.html" },
    { "source": "/blog/cicd-best-practices", "destination": "/blog/cicd-best-practices/index.html" },
    { "source": "/blog/kubernetes-scaling-best-practices", "destination": "/blog/kubernetes-scaling-best-practices/index.html" },
    { "source": "/portfolio/cloud-operations", "destination": "/portfolio/cloud-operations/index.html" },
    { "source": "/blog/aws-lambda-rollback-github-actions", "destination": "/blog/aws-lambda-rollback-github-actions/index.html" }
  ]
}
